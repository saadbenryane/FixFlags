generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  BUILDER
  TEAM
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum AuditStatus {
  QUEUED
  CAPTURING
  CHECKING
  JUDGING
  FINALIZING
  COMPLETED
  FAILED
}

enum AuditPageStatus {
  QUEUED
  CAPTURING
  CHECKING
  JUDGING
  COMPLETED
  PARTIAL
  FAILED
}

enum AuditMode {
  SINGLE
  CRITICAL_PATH
}

enum ReportCompleteness {
  FULL
  PARTIAL
  UNKNOWN
}

enum AssessmentState {
  ASSESSED
  PARTIAL
  UNKNOWN
}

enum LaunchReadinessState {
  SAFE
  FIX_FIRST
  NOT_READY
  UNKNOWN
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum RubricName {
  MESSAGE
  EXPERIENCE
  REACH
}

enum RubricGrade {
  A
  B
  C
  D
  F
}

enum RubricStatus {
  EXCELLENT
  GOOD
  NEEDS_WORK
  CRITICAL
}

enum Severity {
  CRITICAL
  IMPORTANT
  POLISH
}

enum ImpactTag {
  CONVERSION
  REVENUE
  TRUST
  MEASUREMENT
  SHARING
  SEO
  ACCESSIBILITY
  CLARITY
  AUTHORITY
  FRICTION
  EMOTION
}

enum FlagSource {
  DETERMINISTIC
  AI
  JOURNEY
}

enum JourneyReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  ABANDONED
  FAILED
}

enum FlagStatus {
  OPEN
  FIXED
  IGNORED
  REGRESSED
}

enum FixConfidence {
  HIGH
  MEDIUM
  LOW
}

enum CauseCertainty {
  REPRODUCED
  DETECTED
  OBSERVED
  LIKELY
}

enum Device {
  DESKTOP
  MOBILE
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  DISQUALIFIED
}

enum AuditSource {
  HOMEPAGE
  DASHBOARD
  REPORT
  API
  MCP
  SEED
  TOOL_PAGE
  ISSUE_PAGE
  BENCHMARK_PAGE
  UNKNOWN
}

enum SupportSessionStatus {
  OPEN
  WAITING
  ACTIVE
  CLOSED
}

enum SupportMessageRole {
  VISITOR
  AGENT
  SYSTEM
}

model User {
  id                      String             @id @default(cuid())
  email                   String             @unique
  name                    String?
  emailVerified           Boolean            @default(false)
  image                   String?
  role                    String             @default("user")
  plan                    Plan               @default(FREE)
  auditsUsed              Int                @default(0)
  auditsLimit             Int                @default(3)
  stripeCustomerId        String?            @unique
  stripeSubscriptionId    String?            @unique
  stripePriceId           String?
  stripeCurrentPeriodEnd  DateTime?
  subscriptionStatus      SubscriptionStatus @default(NONE)
  vibecodingLevel         String?
  preferredTools          String[]
  gclid                   String?
  fbclid                  String?
  twoFactorEnabled        Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  projects                Project[]
  audits                  Audit[]
  apiKeys                 ApiKey[]
  sessions                Session[]
  accounts                Account[]
  passkeys                Passkey[]
  twoFactors              TwoFactor[]
  emailLogs               EmailLog[]
  linkedLeads             Lead[]             @relation("LeadLinkedUser")
  supportSessions         SupportSession[]   @relation("SupportSessionUser")
  assignedSupportSessions SupportSession[]   @relation("SupportSessionAgent")
  mcpInteractions         McpInteraction[]
  creditPurchases         CreditPurchase[]
  githubConnection        GithubConnection?
  repoScans               RepoScan[]
  repoFixPrs              RepoFixPr[]

  @@map("users")
}

enum RepoScanStatus {
  QUEUED
  CLONING
  SCANNING
  COMPLETED
  FAILED
}

/**
 * App-level GitHub repo access for codebase scanning, separate from GitHub login (Account).
 */
model GithubConnection {
  id                   String     @id @default(cuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId         String
  githubLogin          String
  encryptedAccessToken String     @db.Text
  scope                String
  selectedRepos        String[]
  connectedAt          DateTime   @default(now())
  revokedAt            DateTime?
  repoScans            RepoScan[]

  @@map("github_connections")
}

model RepoScan {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubConnectionId String
  githubConnection   GithubConnection  @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)
  repoFullName       String
  commitSha          String?
  status             RepoScanStatus    @default(QUEUED)
  errorMsg           String?
  startedAt          DateTime?
  completedAt        DateTime?
  findings           RepoScanFinding[]
  fixPrs             RepoFixPr[]
  createdAt          DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([githubConnectionId])
  @@map("repo_scans")
}

model RepoScanFinding {
  id           String     @id @default(cuid())
  repoScanId   String
  repoScan     RepoScan   @relation(fields: [repoScanId], references: [id], onDelete: Cascade)
  severity     Severity
  category     String
  filePath     String
  lineStart    Int?
  lineEnd      Int?
  problem      String
  evidence     String     @db.Text
  fix          String     @db.Text
  agentPrompt  String?    @db.Text
  cursorPrompt String?    @db.Text
  claudePrompt String?    @db.Text
  windsurfPrompt String?  @db.Text
  createdAt    DateTime   @default(now())
  fixPr        RepoFixPr?

  @@index([repoScanId])
  @@map("repo_scan_findings")
}

enum RepoFixPrStatus {
  DRAFT
  CREATING
  CREATED
  FAILED
}

/**
 * A branch + draft PR opened for a single repo-scan finding (v1 write path: PR body is the
 * existing fix prompt, no arbitrary code changes - see lib/repo-scan/mechanical-patch.ts for
 * the narrow, mechanical exception).
 */
model RepoFixPr {
  id           String          @id @default(cuid())
  repoScanId   String
  repoScan     RepoScan        @relation(fields: [repoScanId], references: [id], onDelete: Cascade)
  findingId    String          @unique
  finding      RepoScanFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchName   String
  baseSha      String
  prNumber     Int?
  prUrl        String?
  status       RepoFixPrStatus @default(DRAFT)
  patchApplied Boolean         @default(false)
  errorMsg     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([repoScanId])
  @@index([userId])
  @@map("repo_fix_prs")
}

model EmailLog {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailType  String
  providerId String?
  status     EmailDeliveryStatus @default(PENDING)
  errorMsg   String?             @db.Text
  sentAt     DateTime            @default(now())

  @@unique([userId, emailType])
  @@index([userId])
  @@map("email_logs")
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       NewsletterStatus @default(PENDING)
  source       String           @default("footer")
  subscribedAt DateTime         @default(now())
  confirmedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  @@map("newsletter_subscribers")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  idToken               String?
  scope                 String?
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// WebAuthn / passkey credentials (better-auth passkey plugin)
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

/// Two-factor secrets and backup codes (better-auth twoFactor plugin)
model TwoFactor {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                 String
  backupCodes            String
  verified               Boolean   @default(true)
  failedVerificationCount Int      @default(0)
  lockedUntil            DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String    @unique
  prefix    String
  lastFour  String
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

model Project {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  url                  String
  /** Persistent Product Intelligence JSON — see knowledge/product-intelligence.md */
  productIntelligence  Json?
  audits               Audit[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([userId, url])
  @@map("projects")
}

enum MonitoringMode {
  FULL
  SUMMARY_ONLY
}

model Audit {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  url             String
  status          AuditStatus    @default(QUEUED)
  progress        Int            @default(0)
  monitoringMode  MonitoringMode @default(FULL)
  pipelineLog     Json?
  pipelineVersion String?

  pageJob  String?
  pageType String?
  verdict  String?
  score    Int?

  parentId         String?
  parent           Audit?  @relation("Monitoring", fields: [parentId], references: [id])
  monitoringAudits Audit[] @relation("Monitoring")

  isPublic             Boolean              @default(false)
  skipUsageCount       Boolean              @default(false)
  auditMode            AuditMode            @default(CRITICAL_PATH)
  launchReadiness      Json?
  launchReadinessState LaunchReadinessState @default(UNKNOWN)
  reportCompleteness   ReportCompleteness   @default(UNKNOWN)
  evidenceCoverage     Json?
  includeAi            Boolean              @default(true)
  triageAt             DateTime?
  aiReviewAt           DateTime?
  journeyReviewIncluded Boolean             @default(false)
  journeyReviewAt      DateTime?

  startedAt       DateTime?
  completedAt     DateTime?
  usageCountedAt  DateTime?
  finalizedAt     DateTime?
  leadSyncedAt    DateTime?
  errorMsg        String?
  failureCode     String?
  failureStage    String?
  failureMetadata Json?

  htmlMetadata    Json?
  performanceData Json?
  consoleErrors   Json?
  flowData        Json?
  /** Inferred product intent: purpose, first-value journey, critical outcomes. */
  productContract Json?

  normalizedDomain String?
  source           AuditSource @default(UNKNOWN)
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  gclid            String?
  fbclid           String?

  rubrics     ReportRubric[]
  screenshots Screenshot[]
  flags       Flag[]
  pages       AuditPage[]
  journeyReviews JourneyReview[]
  runCost     AuditRunCost?
  shareLinks  ShareLink[]
  feedback    AuditFeedback[]

  // Knowledge-graph back-references. Nullable + optional so the migration
  // is safe to apply to existing audits; filled by
  // scripts/graph/backfill-historical.ts and the live persist hook.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([userId, status])
  @@index([parentId])
  @@index([normalizedDomain])
  @@index([siteId])
  @@map("audits")
}

model JourneyReview {
  id              String              @id @default(cuid())
  auditId         String
  audit           Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  journeyType     String
  startUrl        String
  status          JourneyReviewStatus @default(QUEUED)
  completedSteps  Int                 @default(0)
  maxSteps        Int                 @default(10)
  goalAchieved    Boolean?
  blockedReason   String?
  abandonedReason String?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  plannerInputTokens    Int     @default(0)
  plannerOutputTokens   Int     @default(0)
  plannerModel          String?
  evaluatorInputTokens  Int     @default(0)
  evaluatorOutputTokens Int     @default(0)
  evaluatorModel        String?
  steps           JourneyStep[]
  findings        JourneyFinding[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([auditId])
  @@index([status])
  @@index([journeyType])
  @@map("journey_reviews")
}

model JourneyStep {
  id                  String        @id @default(cuid())
  journeyReviewId     String
  journeyReview       JourneyReview @relation(fields: [journeyReviewId], references: [id], onDelete: Cascade)
  stepNumber          Int
  actionType          String
  actionDetail        Json
  url                 String
  screenshotBeforeUrl String?
  screenshotAfterUrl  String?
  accessibilityTree   String        @db.Text
  consoleErrors       String[]      @default([])
  networkErrors       String[]      @default([])
  loadTimeMs          Int?
  confidence          Float         @default(1.0)
  reasoning           String?       @db.Text
  createdAt           DateTime      @default(now())

  @@unique([journeyReviewId, stepNumber])
  @@index([journeyReviewId])
  @@map("journey_steps")
}

model JourneyFinding {
  id                    String        @id @default(cuid())
  journeyReviewId       String
  journeyReview         JourneyReview @relation(fields: [journeyReviewId], references: [id], onDelete: Cascade)
  stepNumber            Int
  url                   String
  rubric                RubricName
  severity              Severity
  impactTag             ImpactTag
  problem               String        @db.Text
  evidence              String        @db.Text
  whyItMatters          String        @db.Text
  fix                   String?       @db.Text
  screenshotUrl         String?
  accessibilityEvidence String?       @db.Text
  confidence            Float         @default(0.8)
  reproducibility       String        @default("always")
  flagId                String?
  checkId               String?
  createdAt             DateTime      @default(now())

  @@index([journeyReviewId])
  @@index([rubric])
  @@index([severity])
  @@index([flagId])
  @@map("journey_findings")
}

model ShareLink {
  id           String    @id @default(cuid())
  auditId      String
  audit        Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  token        String    @unique @default(cuid())
  label        String?
  password     String?
  expiresAt    DateTime?
  maxViews     Int?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([auditId])
  @@map("share_links")
}

model Lead {
  id                String           @id @default(cuid())
  normalizedDomain  String           @unique
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  scanCount         Int              @default(1)
  status            LeadStatus       @default(NEW)
  latestScore       Int?
  latestAuditId     String?
  latestUrl         String?
  linkedUserId      String?
  linkedUser        User?            @relation("LeadLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  notes             String?          @db.Text
  source            String?
  totalCostUsd      Decimal          @default(0) @db.Decimal(10, 6)
  latestScanCostUsd Decimal?         @db.Decimal(10, 6)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  supportSessions   SupportSession[]

  @@index([status])
  @@index([lastSeenAt(sort: Desc)])
  @@map("leads")
}

model SupportTenant {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  isUnlimited Boolean          @default(true)
  ownerUserId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    SupportSession[]

  @@map("support_tenants")
}

model SupportSession {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          SupportTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorToken    String
  visitorName     String?
  visitorEmail    String?
  userId          String?
  user            User?                @relation("SupportSessionUser", fields: [userId], references: [id], onDelete: SetNull)
  status          SupportSessionStatus @default(OPEN)
  pageUrl         String?
  leadId          String?
  lead            Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedAgentId String?
  assignedAgent   User?                @relation("SupportSessionAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  lastMessageAt   DateTime?
  lastNotifiedAt  DateTime?
  unreadByAgent   Int                  @default(0)
  unreadByVisitor Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  messages        SupportMessage[]

  @@index([tenantId, visitorToken])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([leadId])
  @@map("support_sessions")
}

model SupportMessage {
  id        String             @id @default(cuid())
  sessionId String
  session   SupportSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      SupportMessageRole
  body      String             @db.Text
  senderId  String?
  createdAt DateTime           @default(now())

  @@index([sessionId, createdAt])
  @@map("support_messages")
}

model AuditPage {
  id              String             @id @default(cuid())
  auditId         String
  audit           Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url             String
  normalizedUrl   String
  title           String?
  role            String
  position        Int
  status          AuditPageStatus    @default(QUEUED)
  completeness    ReportCompleteness @default(UNKNOWN)
  htmlMetadata    Json?
  performanceData Json?
  consoleErrors   Json?
  failureCode     String?
  failureMessage  String?
  screenshots     Screenshot[]
  flags           Flag[]

  // Knowledge-graph: each distinct page URL is also a graph:Page.
  pageId   String?
  page_rel Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditId, normalizedUrl])
  @@unique([auditId, position])
  @@index([auditId, status])
  @@map("audit_pages")
}

model AuditRunCost {
  auditId          String  @id
  audit            Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  durationMs       Int
  llmInputTokens   Int     @default(0)
  llmOutputTokens  Int     @default(0)
  llmModel         String?
  llmCostUsd       Decimal @db.Decimal(10, 6)
  pagespeedCalls   Int     @default(0)
  estimatedCostUsd Decimal @db.Decimal(10, 6)

  // Per-phase LLM breakdown (triage = anonymous teaser pass, prescription = post-signup fixes).
  // llm* columns above stay the running total across phases.
  triageInputTokens        Int     @default(0)
  triageOutputTokens       Int     @default(0)
  triageModel              String?
  triageCostUsd            Decimal @default(0) @db.Decimal(10, 6)
  prescriptionInputTokens  Int     @default(0)
  prescriptionOutputTokens Int     @default(0)
  prescriptionModel        String?
  prescriptionCostUsd      Decimal @default(0) @db.Decimal(10, 6)

  createdAt DateTime @default(now())

  @@map("audit_run_costs")
}

model ReportRubric {
  id              String          @id @default(cuid())
  auditId         String
  audit           Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name            RubricName
  score           Int?
  grade           RubricGrade?
  status          RubricStatus?
  assessmentState AssessmentState @default(UNKNOWN)
  confidence      Float?
  summary         String          @db.Text

  rubricPrompt  String  @db.Text
  cursorPrompt  String? @db.Text
  claudePrompt  String? @db.Text
  windsurfPrompt String? @db.Text
  lovablePrompt String? @db.Text
  boltPrompt    String? @db.Text

  flags Flag[]

  @@unique([auditId, name])
  @@index([auditId])
  @@map("report_rubrics")
}

model Screenshot {
  id      String     @id @default(cuid())
  auditId String
  audit   Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageId  String?
  page    AuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  device  Device
  url     String
  width   Int
  height  Int

  @@index([auditId])
  @@index([pageId])
  @@map("screenshots")
}

model Flag {
  id         String        @id @default(cuid())
  auditId    String
  audit      Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageId     String?
  page       AuditPage?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rubricId   String?
  rubric_rel ReportRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  source     FlagSource

  rubric       String
  impactTag    ImpactTag?
  severity     Severity
  problem      String
  evidence     String     @db.Text
  whyItMatters String     @db.Text
  fix          String     @db.Text
  confidence   Float

  agentPrompt   String? @db.Text
  cursorPrompt  String? @db.Text
  claudePrompt  String? @db.Text
  windsurfPrompt String? @db.Text
  lovablePrompt String? @db.Text
  boltPrompt    String? @db.Text

  verificationRule String? @db.Text

  checkId      String?
  pageUrl      String?
  fingerprint  String?
  position     Int
  status       FlagStatus @default(OPEN)
  resolvedInId String?

  fixConfidence  FixConfidence?
  causeCertainty CauseCertainty?

  feedback  FlagFeedback[]
  createdAt DateTime       @default(now())

  // Knowledge-graph link. Nullable so the migration is safe to apply to
  // existing flags without recomputing fingerprints.
  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([auditId])
  @@index([auditId, checkId])
  @@index([pageId])
  @@index([auditId, fingerprint])
  @@index([issueId])
  @@map("flags")
}

model FlagFeedback {
  id           String   @id @default(cuid())
  flagId       String
  flag         Flag     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId       String?
  visitorToken String?
  vote         Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  @@unique([flagId, userId])
  @@unique([flagId, visitorToken])
  @@index([flagId])
  @@map("flag_feedback")
}

model AuditFeedback {
  id           String   @id @default(cuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  userId       String?
  visitorToken String?
  vote         Int
  comment      String?  @db.Text
  pageUrl      String?
  createdAt    DateTime @default(now())

  @@unique([auditId, visitorToken])
  @@index([auditId])
  @@index([vote])
  @@index([createdAt])
  @@map("audit_feedback")
}

model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  payloadHash String?

  @@index([type])
  @@index([processedAt])
  @@map("processed_stripe_events")
}

model McpInteraction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     String   @default("unknown")
  tool       String?
  durationMs Int?
  success    Boolean  @default(true)
  errorCode  String?
  auditId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([method, tool])
  @@index([success, createdAt])
  @@map("mcp_interactions")
}

model CreditPurchase {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId       String?              @unique
  stripePaymentIntentId String?
  packId                String
  creditsPurchased      Int
  creditsRemaining      Int
  priceUsdCents         Int
  status                CreditPurchaseStatus @default(PENDING)
  createdAt             DateTime             @default(now())
  paidAt                DateTime?

  @@index([userId, status])
  @@map("credit_purchases")
}

// =============================================================================
// Growth / Knowledge Graph
//
// Internal-only entities that model the relationships FixFlags discovers as it
// audits sites. Public artifacts (issue pages, benchmark pages, free tools,
// public reports) are derived from these tables — never read directly.
//
// See docs/growth/architecture.md for the full design.
// =============================================================================

model Site {
  id            String            @id @default(cuid())
  hostname      String            @unique
  rootUrl       String
  firstSeenAt   DateTime          @default(now())
  lastAuditedAt DateTime          @default(now())
  auditCount    Int               @default(0)
  industryGuess String?
  techGuess     Json?
  pages         Page[]
  audits        Audit[]
  // Note: per-flag linkage to a Site lives in graph_issue_occurrence, not as
  // a direct relation — keeps this model cheap to query by hostname alone.
  technologies  SiteTechnology[]
  industry      Industry?         @relation(fields: [industryId], references: [id], onDelete: SetNull)
  industryId    String?
  occurrences   IssueOccurrence[]

  @@index([lastAuditedAt])
  @@map("graph_site")
}

model Page {
  id          String      @id @default(cuid())
  siteId      String
  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url         String
  path        String
  role        String
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  audits      AuditPage[]

  @@unique([siteId, url])
  @@index([siteId])
  @@map("graph_page")
}

model Technology {
  id    String           @id @default(cuid())
  name  String           @unique
  kind  String
  sites SiteTechnology[]

  @@map("graph_technology")
}

model SiteTechnology {
  siteId       String
  technologyId String
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  confidence   Float    @default(1.0)

  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([siteId, technologyId])
  @@index([technologyId])
  @@map("graph_site_technology")
}

model Industry {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  sites Site[]

  @@map("graph_industry")
}

model Issue {
  id              String              @id @default(cuid())
  // Stable hash of (checkId, normalized-evidence-shape). Same fingerprint
  // across sites means it's the same underlying problem.
  fingerprint     String              @unique
  checkId         String
  rubric          String
  problemTemplate String              @db.Text
  fixTemplate     String              @db.Text
  // Denormalized counters, recomputed by scripts/growth/issue-frequencies.ts
  occurrenceCount Int                 @default(0)
  siteCount       Int                 @default(0)
  frameworkCount  Int                 @default(0)
  // Top-N redacted public examples — opaque to end users, drives the issue
  // page's "what this looks like in the wild" section.
  examples        Json?
  firstSeenAt     DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  flags           Flag[]
  occurrences     IssueOccurrence[]
  fixPrompts      FixPrompt[]
  snapshots       BenchmarkSnapshot[]

  @@index([checkId])
  @@index([rubric])
  @@index([occurrenceCount])
  @@map("graph_issue")
}

model IssueOccurrence {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  flagId     String   @unique
  observedAt DateTime @default(now())

  @@index([issueId])
  @@index([siteId])
  @@map("graph_issue_occurrence")
}

model FixPrompt {
  id          String   @id @default(cuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // cursor | claude | lovable | bolt | generic
  tool        String
  template    String   @db.Text
  usageCount  Int      @default(0)
  // Populated by flag feedback + re-audit signal over time.
  successRate Float?
  createdAt   DateTime @default(now())

  @@unique([issueId, tool])
  @@index([issueId])
  @@map("graph_fix_prompt")
}

model BenchmarkSnapshot {
  id            String   @id @default(cuid())
  // e.g. "industry:saas", "framework:nextjs", "builder:lovable",
  // "industry:saas+framework:nextjs"
  scope         String
  takenAt       DateTime @default(now())
  sampleSize    Int
  avgScore      Float
  p25Score      Float
  p50Score      Float
  p75Score      Float
  flagFrequency Json
  topIssues     Json
  // Optional reference to the dominant issue driving the snapshot.
  topIssueId    String?
  topIssue      Issue?   @relation(fields: [topIssueId], references: [id], onDelete: SetNull)

  @@index([scope, takenAt])
  @@map("graph_benchmark_snapshot")
}

model Experiment {
  id         String    @id @default(cuid())
  slug       String    @unique
  hypothesis String    @db.Text
  // landing-page | programmatic-page | free-tool | on-platform | outbound
  surface    String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  metric     String
  baseline   Float?
  result     Float?
  decision   String? // kept | reverted | inconclusive
  notes      String?   @db.Text

  @@index([surface, startedAt])
  @@map("graph_experiment")
}

model ToolUsage {
  id        String   @id @default(cuid())
  // meta-preview | cta-above-fold | placeholder-copy-detector | ...
  toolSlug  String
  // Hash of normalized input — never the input itself; no PII.
  inputHash String
  result    Json
  // Did the user click the CTA into the audit flow within the same session?
  // Set by a correlation id from the client; null if unknown.
  sessionId String?
  // Organic attribution surface for funnel reads.
  source    String?
  createdAt DateTime @default(now())

  @@index([toolSlug, createdAt])
  @@index([source, createdAt])
  @@map("graph_tool_usage")
}

model GrowthArtifact {
  // Files written to docs/growth/metrics/ and similar — one row per file
  // emission. Tracks the data lineage of every public statement we make.
  id        String   @id @default(cuid())
  // gsc-rolling-30d | benchmark-snapshot | opportunity-report | ...
  kind      String
  path      String   @unique
  payload   Json
  writtenAt DateTime @default(now())

  @@index([kind, writtenAt])
  @@map("graph_artifact")
}
