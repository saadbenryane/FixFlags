generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                       @id @default(cuid())
  email                   String                       @unique
  name                    String?
  emailVerified           Boolean                      @default(false)
  role                    String                       @default("user")
  plan                    Plan                         @default(FREE)
  auditsUsed              Int                          @default(0)
  auditsLimit             Int                          @default(3)
  stripeCustomerId        String?                      @unique
  stripeSubscriptionId    String?                      @unique
  stripePriceId           String?
  stripeCurrentPeriodEnd  DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  subscriptionStatus      SubscriptionStatus           @default(NONE)
  preferredTools          String[]
  vibecodingLevel         String?
  image                   String?
  gclid                   String?
  fbclid                  String?
  twoFactorEnabled        Boolean                      @default(false)
  founderOfferRedeemedAt  DateTime?
  deepReviewsUsed         Int                          @default(0)
  deepReviewsLimit        Int                          @default(1)
  gscConnection           GscConnection?
  accounts                Account[]
  apiKeys                 ApiKey[]
  audits                  Audit[]
  cliDeviceAuthorizations CliDeviceAuthorization[]
  creditPurchases         CreditPurchase[]
  emailLogs               EmailLog[]
  githubConnection        GithubConnection?
  linkedLeads             Lead[]                       @relation("LeadLinkedUser")
  mcpInteractions         McpInteraction[]
  paidPlanWaitlistEntries PaidPlanWaitlistEntry[]
  passkeys                Passkey[]
  projects                Project[]
  repoFixPrs              RepoFixPr[]
  repoScans               RepoScan[]
  reportChatMessages      ReportChatMessage[]
  chatUsagePeriods        ChatUsagePeriod[]
  createdCanvases         ReportCanvas[]               @relation("CanvasCreator")
  canvasVersions          CanvasVersion[]              @relation("CanvasVersionCreator")
  sessions                Session[]
  subscriptionLifecycle   SubscriptionLifecycleEvent[]
  assignedSupportSessions SupportSession[]             @relation("SupportSessionAgent")
  supportSessions         SupportSession[]             @relation("SupportSessionUser")
  twoFactors              TwoFactor[]
  waitlistInvitesSent     WaitlistInvite[]             @relation("WaitlistInviter")
  waitlistInvitesRedeemed WaitlistInvite[]             @relation("WaitlistInvitee")
  waitlistLeads           WaitlistLead[]               @relation("WaitlistLeadClaimedUser")

  @@map("users")
}

model PaidPlanWaitlistEntry {
  id              String    @id @default(cuid())
  userId          String
  plan            Plan
  joinedAt        DateTime  @default(now())
  source          String?
  campaign        String?
  invitedAt       DateTime?
  convertedAt     DateTime?
  /// * Legacy: retired 40% founder offer reference. Kept for historical rows.
  founderOfferId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// *
  ///    * Launch discount tier snapshot at join time, by join order per plan:
  ///    * 1 = first 500 (25% off), 2 = next 500 (15% off), null = list price.
  ///    * Assigned under a per-plan advisory lock; never changes on re-join.
  discountTier    Int?
  /// *
  ///    * Email captured at join time. May differ from the account email (e.g. SSO
  ///    * private relay); the confirmation goes to this address.
  email           String?
  /// *
  ///    * Access cohort for the "first 500, then next 500" launch: 1 = first
  ///    * WAITLIST_BATCH_SIZE joiners per plan, 2 = the next WAITLIST_BATCH_SIZE,
  ///    * null = beyond both caps (list price, access once batches fully open).
  ///    * Snapshot at join time under the same per-plan advisory lock as the
  ///    * discount tier; never changes on re-join.
  batch           Int?
  /// *
  ///    * Per-user access grant. Set when the member's batch is released (admin
  ///    * bulk grant) or when an invite code is redeemed. Checkout also accepts
  ///    * batch <= WAITLIST_OPEN_BATCH without an explicit grant.
  accessGrantedAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plan])
  @@index([plan, joinedAt(sort: Desc)])
  @@index([plan, discountTier])
  @@index([invitedAt])
  @@index([plan, batch])
  @@index([accessGrantedAt])
  @@map("paid_plan_waitlist_entries")
}

/// *
///    * One-time invite for a specific person: a unique short code plus a
///    * /waitlist/<plan>?code=... share link. Redeeming the code creates (or
///    * claims) the invitee's waitlist row with the invite's batch and an
///    * immediate access grant. Codes are admin-generated for batch releases and
///    * are not user-enterable promotion codes.
model WaitlistInvite {
  id            String               @id @default(cuid())
  inviteeEmail  String
  /// Null for system/bulk invites (admin batch release).
  inviterUserId String?
  plan          Plan
  /// Access cohort the invitee joins (1 or 2). Null defers to join-order batch.
  batch         Int?
  status        WaitlistInviteStatus @default(PENDING)
  /// 8-char URL-safe random code (base64url), unique.
  code          String               @unique
  invitedAt     DateTime             @default(now())
  redeemedAt    DateTime?
  joinedUserId  String?
  inviter       User?                @relation("WaitlistInviter", fields: [inviterUserId], references: [id])
  joinedUser    User?                @relation("WaitlistInvitee", fields: [joinedUserId], references: [id])

  @@index([plan, batch])
  @@index([inviteeEmail])
  @@index([status])
  @@map("waitlist_invites")
}

/// *
///    * Email-only pre-account waitlist capture. A visitor without a session can
///    * join with just an email; the row is claimed when the account signs up and
///    * joins (attach on signup), carrying any invite-granted batch and access
///    * grant onto the real PaidPlanWaitlistEntry.
model WaitlistLead {
  id              String             @id @default(cuid())
  email           String
  plan            Plan
  /// Access cohort reserved by an invite redeem (null for plain joins: the
  /// batch is assigned from join position when the entry is created).
  batch           Int?
  accessGrantedAt DateTime?
  source          String?
  campaign        String?
  status          WaitlistLeadStatus @default(PENDING)
  claimedUserId   String?
  claimedAt       DateTime?
  joinedAt        DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  claimedUser     User?              @relation("WaitlistLeadClaimedUser", fields: [claimedUserId], references: [id])

  @@unique([email, plan])
  @@index([plan, status])
  @@index([plan, batch])
  @@map("waitlist_leads")
}

/// *
///  * App-level GitHub repo access for codebase scanning, separate from GitHub login (Account).
model GithubConnection {
  id                   String     @id @default(cuid())
  userId               String     @unique
  githubUserId         String
  githubLogin          String
  encryptedAccessToken String
  scope                String
  selectedRepos        String[]
  connectedAt          DateTime   @default(now())
  revokedAt            DateTime?
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoScans            RepoScan[]

  @@map("github_connections")
}

model RepoScan {
  id                 String            @id @default(cuid())
  userId             String
  githubConnectionId String
  repoFullName       String
  commitSha          String?
  status             RepoScanStatus    @default(QUEUED)
  errorMsg           String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  fixPrs             RepoFixPr[]
  findings           RepoScanFinding[]
  githubConnection   GithubConnection  @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([githubConnectionId])
  @@map("repo_scans")
}

model RepoScanFinding {
  id             String     @id @default(cuid())
  repoScanId     String
  severity       Severity
  category       String
  filePath       String
  lineStart      Int?
  lineEnd        Int?
  problem        String
  evidence       String
  fix            String
  agentPrompt    String?
  cursorPrompt   String?
  claudePrompt   String?
  createdAt      DateTime   @default(now())
  windsurfPrompt String?
  fixPr          RepoFixPr?
  repoScan       RepoScan   @relation(fields: [repoScanId], references: [id], onDelete: Cascade)

  @@index([repoScanId])
  @@map("repo_scan_findings")
}

/// *
///  * A branch + draft PR opened for a single repo-scan finding (v1 write path: PR body is the
///  * existing fix prompt, no arbitrary code changes - see lib/repo-scan/mechanical-patch.ts for
///  * the narrow, mechanical exception).
model RepoFixPr {
  id           String          @id @default(cuid())
  repoScanId   String
  findingId    String          @unique
  userId       String
  branchName   String
  baseSha      String
  prNumber     Int?
  prUrl        String?
  status       RepoFixPrStatus @default(DRAFT)
  patchApplied Boolean         @default(false)
  errorMsg     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  finding      RepoScanFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  repoScan     RepoScan        @relation(fields: [repoScanId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([repoScanId])
  @@index([userId])
  @@map("repo_fix_prs")
}

model EmailLog {
  id         String              @id @default(cuid())
  userId     String
  emailType  String
  sentAt     DateTime            @default(now())
  providerId String?
  status     EmailDeliveryStatus @default(PENDING)
  errorMsg   String?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emailType])
  @@index([userId])
  @@map("email_logs")
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       NewsletterStatus @default(PENDING)
  source       String           @default("footer")
  subscribedAt DateTime         @default(now())
  confirmedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  @@map("newsletter_subscribers")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  password              String?
  idToken               String?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// WebAuthn / passkey credentials (better-auth passkey plugin)
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

/// Two-factor secrets and backup codes (better-auth twoFactor plugin)
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model ApiKey {
  id                      String                   @id @default(cuid())
  userId                  String
  name                    String
  lastUsed                DateTime?
  createdAt               DateTime                 @default(now())
  keyHash                 String                   @unique
  prefix                  String
  lastFour                String
  revokedAt               DateTime?
  client                  ApiKeyClient?
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliDeviceAuthorizations CliDeviceAuthorization[]
  mcpInteractions         McpInteraction[]

  @@index([userId])
  @@index([client])
  @@map("api_keys")
}

model CliDeviceAuthorization {
  id                  String                       @id @default(cuid())
  deviceCodeHash      String                       @unique
  userCodeHash        String                       @unique
  status              CliDeviceAuthorizationStatus @default(PENDING)
  intervalSeconds     Int                          @default(5)
  encryptedCredential String?
  userId              String?
  apiKeyId            String?
  lastPolledAt        DateTime?
  expiresAt           DateTime
  approvedAt          DateTime?
  consumedAt          DateTime?
  createdAt           DateTime                     @default(now())
  apiKey              ApiKey?                      @relation(fields: [apiKeyId], references: [id])
  user                User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("cli_device_authorizations")
}

model Project {
  id                          String                @id @default(cuid())
  userId                      String
  name                        String
  url                         String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  /// *
  ///    * Persistent Product Intelligence JSON — see knowledge/product-intelligence.md
  productIntelligence         Json?
  watchNextRunAt              DateTime?
  watchLastRunAt              DateTime?
  /// *
  ///    * Lowercase hostname without www. Exact Product identity within an account.
  canonicalHost               String
  /// *
  ///    * Agency-promoted Project. Internal Products remain available without consuming quota.
  isManaged                   Boolean               @default(false)
  /// *
  ///    * Optimistic concurrency revision for all Product Intelligence mutations.
  productIntelligenceRevision Int                   @default(0)
  watchLeaseUntil             DateTime?
  watchLastAttemptAt          DateTime?
  watchConsecutiveFailures    Int                   @default(0)
  watchLastError              String?
  watchInterval               ProjectWatchInterval?
  /// *
  ///    * Encrypted scan access (HTTP basic, cookies, headers) for preview/staging URLs.
  scanAccessEncrypted         String?
  audits                      Audit[]
  canvases                    ReportCanvas[]
  improvements                Improvement[]
  releases                    ProductRelease[]
  signalKeys                  ProductSignalKey[]
  signals                     ProductSignal[]
  user                        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalHost])
  @@index([userId])
  @@index([watchNextRunAt])
  @@index([watchLeaseUntil])
  @@map("projects")
}

model Audit {
  id                         String                       @id @default(cuid())
  userId                     String?
  projectId                  String?
  url                        String
  status                     AuditStatus                  @default(QUEUED)
  pageJob                    String?
  pageType                   String?
  verdict                    String?
  score                      Int?
  parentId                   String?
  isPublic                   Boolean                      @default(false)
  startedAt                  DateTime?
  completedAt                DateTime?
  errorMsg                   String?
  htmlMetadata               Json?
  performanceData            Json?
  consoleErrors              Json?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  progress                   Int                          @default(0)
  skipUsageCount             Boolean                      @default(false)
  usageCountedAt             DateTime?
  auditMode                  AuditMode                    @default(CRITICAL_PATH)
  launchReadiness            Json?
  launchReadinessState       LaunchReadinessState         @default(UNKNOWN)
  reportCompleteness         ReportCompleteness           @default(UNKNOWN)
  evidenceCoverage           Json?
  finalizedAt                DateTime?
  improvementProjectedAt     DateTime?
  failureCode                String?
  failureStage               String?
  failureMetadata            Json?
  pipelineLog                Json?
  pipelineVersion            String?
  monitoringMode             MonitoringMode               @default(FULL)
  flowData                   Json?
  normalizedDomain           String?
  source                     AuditSource                  @default(UNKNOWN)
  referrer                   String?
  utmSource                  String?
  utmMedium                  String?
  utmCampaign                String?
  leadSyncedAt               DateTime?
  includeAi                  Boolean                      @default(true)
  aiReviewAt                 DateTime?
  triageAt                   DateTime?
  gclid                      String?
  fbclid                     String?
  siteId                     String?
  journeyReviewIncluded      Boolean                      @default(false)
  journeyReviewAt            DateTime?
  /// *
  ///    * Inferred product intent: purpose, first-value journey, critical outcomes.
  productContract            Json?
  watchNotifiedAt            DateTime?
  recheckTrigger             RecheckTrigger?
  watchRegressionCount       Int?
  watchNotificationStatus    WatchNotificationStatus      @default(NOT_APPLICABLE)
  watchNotificationAttempts  Int                          @default(0)
  watchNotificationLastError String?
  /// *
  ///    * Per-audit scan access override (encrypted). Falls back to Project.scanAccessEncrypted.
  scanAccessEncrypted        String?
  technologyDetectionStatus  TechnologyDetectionStatus    @default(NOT_CAPTURED)
  technologyDetectorVersion  String?
  technologyDetectedAt       DateTime?
  deepReviewUsageCountedAt   DateTime?
  /// *
  ///    * Names of deterministic check modules that threw during this run. Their
  ///    * findings are dropped, so the report shows a callout when this is non-empty.
  failedModules              Json?
  indexStatuses              IndexStatus[]
  searchPerformance          SearchPerformance[]
  feedback                   AuditFeedback[]
  pages                      AuditPage[]
  runCost                    AuditRunCost?
  technologyObservations     AuditTechnologyObservation[]
  parent                     Audit?                       @relation("Monitoring", fields: [parentId], references: [id])
  monitoringAudits           Audit[]                      @relation("Monitoring")
  project                    Project?                     @relation(fields: [projectId], references: [id])
  site                       Site?                        @relation(fields: [siteId], references: [id])
  user                       User?                        @relation(fields: [userId], references: [id])
  flags                      Flag[]
  journeyReviews             JourneyReview[]
  chatMessages               ReportChatMessage[]
  rubrics                    ReportRubric[]
  screenshots                Screenshot[]
  shareLinks                 ShareLink[]
  sourceCanvases             ReportCanvas[]
  improvementOccurrences     ImprovementOccurrence[]
  sourceImprovementAttempts  ImprovementAttempt[]         @relation("ImprovementSourceReview")
  verificationAttempts       ImprovementAttempt[]         @relation("ImprovementVerificationReview")

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([userId, status])
  @@index([parentId])
  @@index([normalizedDomain])
  @@index([siteId])
  @@map("audits")
}

model ReportCanvas {
  id             String          @id @default(cuid())
  projectId      String
  sourceAuditId  String
  title          String
  status         CanvasStatus    @default(GENERATING)
  currentVersion Int             @default(0)
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAudit    Audit           @relation(fields: [sourceAuditId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("CanvasCreator", fields: [createdById], references: [id], onDelete: Cascade)
  versions       CanvasVersion[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@index([sourceAuditId])
  @@index([createdById])
  @@map("report_canvases")
}

model CanvasVersion {
  id               String       @id @default(cuid())
  canvasId         String
  version          Int
  instruction      String
  document         Json
  sourceRefs       Json
  model            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  createdById      String
  createdAt        DateTime     @default(now())
  canvas           ReportCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("CanvasVersionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([canvasId, version])
  @@index([createdById])
  @@map("canvas_versions")
}

model ReportChatMessage {
  id        String   @id @default(cuid())
  auditId   String
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@index([userId])
  @@map("report_chat_messages")
}

model ChatUsagePeriod {
  id             String                 @id @default(cuid())
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  limitTokens    Int
  inputTokens    Int                    @default(0)
  outputTokens   Int                    @default(0)
  reservedTokens Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations   ChatUsageReservation[]

  @@unique([userId, periodStart])
  @@index([periodEnd])
  @@map("chat_usage_periods")
}

model ChatUsageReservation {
  id             String          @id @default(cuid())
  periodId       String
  reservedTokens Int
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  status         String          @default("RESERVED")
  createdAt      DateTime        @default(now())
  expiresAt      DateTime
  finalizedAt    DateTime?
  period         ChatUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, status, expiresAt])
  @@map("chat_usage_reservations")
}

model JourneyReview {
  id                    String              @id @default(cuid())
  auditId               String
  journeyType           String
  startUrl              String
  status                JourneyReviewStatus @default(QUEUED)
  completedSteps        Int                 @default(0)
  maxSteps              Int                 @default(10)
  goalAchieved          Boolean?
  blockedReason         String?
  abandonedReason       String?
  startedAt             DateTime?
  completedAt           DateTime?
  durationMs            Int?
  plannerInputTokens    Int                 @default(0)
  plannerOutputTokens   Int                 @default(0)
  plannerModel          String?
  evaluatorInputTokens  Int                 @default(0)
  evaluatorOutputTokens Int                 @default(0)
  evaluatorModel        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  planJson              Json?
  findings              JourneyFinding[]
  audit                 Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  steps                 JourneyStep[]

  @@index([auditId])
  @@index([status])
  @@index([journeyType])
  @@map("journey_reviews")
}

model JourneyStep {
  id                  String        @id @default(cuid())
  journeyReviewId     String
  stepNumber          Int
  actionType          String
  actionDetail        Json
  url                 String
  screenshotBeforeUrl String?
  screenshotAfterUrl  String?
  accessibilityTree   String
  consoleErrors       String[]      @default([])
  networkErrors       String[]      @default([])
  loadTimeMs          Int?
  confidence          Float         @default(1.0)
  reasoning           String?
  createdAt           DateTime      @default(now())
  elementRef          String?
  elementDescription  String?
  outcomeMatch        Boolean?
  outcomeDetail       String?
  journeyReview       JourneyReview @relation(fields: [journeyReviewId], references: [id], onDelete: Cascade)

  @@unique([journeyReviewId, stepNumber])
  @@index([journeyReviewId])
  @@map("journey_steps")
}

model JourneyFinding {
  id                    String        @id @default(cuid())
  journeyReviewId       String
  stepNumber            Int
  url                   String
  rubric                RubricName
  severity              Severity
  impactTag             ImpactTag
  problem               String
  evidence              String
  whyItMatters          String
  fix                   String?
  screenshotUrl         String?
  accessibilityEvidence String?
  confidence            Float         @default(0.8)
  reproducibility       String        @default("always")
  flagId                String?
  checkId               String?
  createdAt             DateTime      @default(now())
  findingType           String?
  journeyReview         JourneyReview @relation(fields: [journeyReviewId], references: [id], onDelete: Cascade)

  @@index([journeyReviewId])
  @@index([rubric])
  @@index([severity])
  @@index([flagId])
  @@map("journey_findings")
}

model ShareLink {
  id           String    @id @default(cuid())
  auditId      String
  token        String    @unique
  label        String?
  expiresAt    DateTime?
  maxViews     Int?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  passwordHash String?
  version      Int       @default(1)
  audit        Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@map("share_links")
}

model Lead {
  id                String           @id @default(cuid())
  normalizedDomain  String           @unique
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  scanCount         Int              @default(1)
  status            LeadStatus       @default(NEW)
  latestScore       Int?
  latestAuditId     String?
