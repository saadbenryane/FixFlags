generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  BUILDER
  TEAM
  STUDIO
}

enum AuditStatus {
  QUEUED
  CAPTURING
  CHECKING
  JUDGING
  FINALIZING
  COMPLETED
  FAILED
}

enum AuditPageStatus {
  QUEUED
  CAPTURING
  CHECKING
  JUDGING
  COMPLETED
  PARTIAL
  FAILED
}

enum AuditMode {
  SINGLE
  CRITICAL_PATH
}

enum ReportCompleteness {
  FULL
  PARTIAL
  UNKNOWN
}

enum AssessmentState {
  ASSESSED
  PARTIAL
  UNKNOWN
}

enum LaunchReadinessState {
  SAFE
  FIX_FIRST
  NOT_READY
  UNKNOWN
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum RubricName {
  MESSAGE
  EXPERIENCE
  REACH
}

enum RubricGrade {
  A
  B
  C
  D
  F
}

enum RubricStatus {
  EXCELLENT
  GOOD
  NEEDS_WORK
  CRITICAL
}

enum Severity {
  CRITICAL
  IMPORTANT
  POLISH
}

enum ImpactTag {
  CONVERSION
  REVENUE
  TRUST
  MEASUREMENT
  SHARING
  SEO
  ACCESSIBILITY
}

enum FlagSource {
  DETERMINISTIC
  AI
}

enum FlagStatus {
  OPEN
  FIXED
  IGNORED
  REGRESSED
}

enum Device {
  DESKTOP
  MOBILE
}

enum ExpertReviewStatus {
  PENDING
  PAID
  IN_REVIEW
  DELIVERED
  FULFILLED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String?
  emailVerified          Boolean             @default(false)
  role                   String              @default("user")
  plan                   Plan                @default(FREE)
  auditsUsed             Int                 @default(0)
  auditsLimit            Int                 @default(3)
  stripeCustomerId       String?             @unique
  stripeSubscriptionId   String?             @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  subscriptionStatus     SubscriptionStatus  @default(NONE)
  freeRecheckUsedAt      DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  projects               Project[]
  audits                 Audit[]
  apiKeys                ApiKey[]
  sessions               Session[]
  accounts               Account[]
  emailLogs              EmailLog[]
  expertReviewOrders     ExpertReviewOrder[]
  expertReviewEvents     ExpertReviewEvent[] @relation("ExpertReviewEventActor")

  @@map("users")
}

model EmailLog {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailType  String
  providerId String?
  status     EmailDeliveryStatus @default(PENDING)
  errorMsg   String?             @db.Text
  sentAt     DateTime            @default(now())

  @@unique([userId, emailType])
  @@index([userId])
  @@map("email_logs")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String    @unique
  prefix    String
  lastFour  String
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  audits    Audit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("projects")
}

enum RecheckMode {
  FULL
  SUMMARY_ONLY
}

model Audit {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  url       String
  status    AuditStatus @default(QUEUED)
  progress  Int         @default(0)
  recheckMode          RecheckMode @default(FULL)
  pipelineLog          Json?
  pipelineVersion      String?

  pageJob  String?
  pageType String?
  verdict  String?
  score    Int?

  parentId String?
  parent   Audit?  @relation("Rechecks", fields: [parentId], references: [id])
  rechecks Audit[] @relation("Rechecks")

  isPublic             Boolean              @default(false)
  skipUsageCount       Boolean              @default(false)
  trialRecheck         Boolean              @default(false)
  auditMode            AuditMode            @default(SINGLE)
  launchReadiness      Json?
  launchReadinessState LaunchReadinessState @default(UNKNOWN)
  reportCompleteness   ReportCompleteness   @default(UNKNOWN)
  evidenceCoverage     Json?

  startedAt       DateTime?
  completedAt     DateTime?
  usageCountedAt  DateTime?
  finalizedAt     DateTime?
  errorMsg        String?
  failureCode     String?
  failureStage    String?
  failureMetadata Json?

  htmlMetadata    Json?
  performanceData Json?
  consoleErrors   Json?

  rubrics            ReportRubric[]
  screenshots        Screenshot[]
  flags              Flag[]
  pages              AuditPage[]
  runCost            AuditRunCost?
  expertReviewOrders ExpertReviewOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([userId, status])
  @@index([parentId])
  @@map("audits")
}

model AuditPage {
  id              String             @id @default(cuid())
  auditId         String
  audit           Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url             String
  normalizedUrl   String
  title           String?
  role            String
  position        Int
  status          AuditPageStatus    @default(QUEUED)
  completeness    ReportCompleteness @default(UNKNOWN)
  htmlMetadata    Json?
  performanceData Json?
  consoleErrors   Json?
  failureCode     String?
  failureMessage  String?
  screenshots     Screenshot[]
  flags           Flag[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([auditId, normalizedUrl])
  @@unique([auditId, position])
  @@index([auditId, status])
  @@map("audit_pages")
}

model AuditRunCost {
  auditId          String   @id
  audit            Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  durationMs       Int
  llmInputTokens   Int      @default(0)
  llmOutputTokens  Int      @default(0)
  llmModel         String?
  llmCostUsd       Decimal  @db.Decimal(10, 6)
  pagespeedCalls   Int      @default(0)
  estimatedCostUsd Decimal  @db.Decimal(10, 6)
  createdAt        DateTime @default(now())

  @@map("audit_run_costs")
}

model ReportRubric {
  id              String          @id @default(cuid())
  auditId         String
  audit           Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name            RubricName
  score           Int?
  grade           RubricGrade?
  status          RubricStatus?
  assessmentState AssessmentState @default(UNKNOWN)
  confidence      Float?
  summary         String          @db.Text

  rubricPrompt  String  @db.Text
  cursorPrompt  String? @db.Text
  claudePrompt  String? @db.Text
  lovablePrompt String? @db.Text
  boltPrompt    String? @db.Text

  flags Flag[]

  @@unique([auditId, name])
  @@index([auditId])
  @@map("report_rubrics")
}

model Screenshot {
  id      String     @id @default(cuid())
  auditId String
  audit   Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageId  String?
  page    AuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  device  Device
  url     String
  width   Int
  height  Int

  @@index([auditId])
  @@index([pageId])
  @@map("screenshots")
}

model Flag {
  id       String     @id @default(cuid())
  auditId  String
  audit    Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageId   String?
  page     AuditPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rubricId String?
  rubric_rel ReportRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  source   FlagSource

  rubric       String
  impactTag    ImpactTag?
  severity     Severity
  problem      String
  evidence     String   @db.Text
  whyItMatters String   @db.Text
  fix          String   @db.Text
  confidence   Float

  agentPrompt   String? @db.Text
  cursorPrompt  String? @db.Text
  claudePrompt  String? @db.Text
  lovablePrompt String? @db.Text
  boltPrompt    String? @db.Text

  verificationRule String? @db.Text

  checkId      String?
  pageUrl      String?
  fingerprint  String?
  position     Int
  status       FlagStatus @default(OPEN)
  resolvedInId String?

  feedback  FlagFeedback[]
  createdAt DateTime       @default(now())

  @@index([auditId])
  @@index([auditId, checkId])
  @@index([pageId])
  @@index([auditId, fingerprint])
  @@map("flags")
}

model FlagFeedback {
  id        String   @id @default(cuid())
  flagId    String
  flag      Flag     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId    String?
  vote      Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([flagId, userId])
  @@index([flagId])
  @@map("flag_feedback")
}

model ExpertReviewOrder {
  id              String                   @id @default(cuid())
  userId          String?
  user            User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  auditId         String?
  audit           Audit?                   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  stripeSessionId String                   @unique
  status          ExpertReviewStatus       @default(PENDING)
  deliverable     ExpertReviewDeliverable?
  events          ExpertReviewEvent[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([auditId])
  @@map("expert_review_orders")
}

model ExpertReviewDeliverable {
  id          String            @id @default(cuid())
  orderId     String            @unique
  order       ExpertReviewOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  summary     String            @db.Text
  priorities  Json
  reportUrl   String?
  authoredBy  String
  deliveredAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([orderId])
  @@map("expert_review_deliverables")
}

model ExpertReviewEvent {
  id        String            @id @default(cuid())
  orderId   String
  order     ExpertReviewOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?             @relation("ExpertReviewEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([orderId, createdAt])
  @@unique([orderId, type])
  @@index([actorId])
  @@map("expert_review_events")
}

model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  payloadHash String?

  @@index([type])
  @@index([processedAt])
  @@map("processed_stripe_events")
}
