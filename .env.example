# ─── Required for audits ───────────────────────────────────────────────────
DATABASE_URL="postgresql://fixflags:fixflags@localhost:5432/fixflags"
REDIS_URL="redis://localhost:6379"
# Parallel audit jobs per worker process (default 5). Used by worker + queue wait estimates.
# On a single small instance running the inline worker, keep this modest (e.g. 2).
# AUDIT_WORKER_CONCURRENCY="5"
# The web service runs the audit worker in-process by default, so one service is
# enough. Set to "false" only when running dedicated worker services.
# INLINE_WORKER="true"
# Set one LLM provider (OpenAI is preferred when both are set). Optional: with
# neither set, audits still complete with deterministic checks (no AI review).
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ─── Advanced: AI judge tuning (optional) ────────────────────────────────────
# JUDGE_PROVIDER_CHAIN="openai,anthropic"   # order to try providers
# OPENAI_JUDGE_MODEL="gpt-4o-mini"
# ANTHROPIC_JUDGE_MODEL="claude-sonnet-4-20250514"
# OPENAI_JUDGE_MAX_TOKENS="4096"
# OPENAI_JUDGE_IMAGE_DETAIL="low"           # low | high | auto
# JUDGE_TIMEOUT_MS="60000"                  # clamped to the audit's remaining budget
# CRITICAL_PATH_CONCURRENCY="3"             # parallel pages for critical-path audits

# ─── Required for auth ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET="generate-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Railway web service): set all three to https://fixflags.com
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL must match exactly.

# ─── OAuth SSO (Google / GitHub) — both ID + secret required per provider ───
# Provider availability is resolved at RUNTIME (GET /api/auth/providers), so
# setting these on the deployed service lights up the sign-in buttons with NO
# rebuild required. Callback URLs to register in each provider console:
#   Google: {BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub: {BETTER_AUTH_URL}/api/auth/callback/github
# Local: http://localhost:3000/api/auth/callback/google (and github)
# Prod:  https://fixflags.com/api/auth/callback/google (and github)
# Run: npm run auth:check
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# The same GitHub OAuth app also powers Max-plan codebase scanning
# (lib/integrations/github.ts) with a separate `repo`-scope callback.
# Register this additional callback URL in the same GitHub OAuth app:
#   {BETTER_AUTH_URL}/api/integrations/github/callback

# ─── Required for codebase scanning (Max plan) ───────────────────────────────
# Encrypts GitHub access tokens at rest (AES-256-GCM). Generate: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=""

# ─── Stripe billing (required in production) ─────────────────────────────────
# For local dev: npm run stripe:listen (forwards webhooks to localhost)
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""          # whsec_... from stripe listen output
# STRIPE_BUILDER_PRICE_ID=""
# STRIPE_TEAM_PRICE_ID=""
# STRIPE_EXPERT_REVIEW_PRICE_ID=""
# STRIPE_CREDIT_PACK_10_ID=""
# STRIPE_CREDIT_PACK_25_ID=""
# STRIPE_CREDIT_PACK_50_ID=""
# STRIPE_EXPERT_REVIEW_PRICE_USD="500"
# STRIPE_API_VERSION="2025-02-24.acacia"

# ─── Optional: Google Analytics 4 (frontend tracking) ───────────────────────
# GA4 Measurement ID. When set, gtag.js loads and tracks pageviews/events.
# Leave unset to disable analytics entirely (e.g. local dev).
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ─── Optional: Google Search Console domain verification ─────────────────────
# Meta tag content value from Search Console → Settings → Ownership verification
# GOOGLE_SITE_VERIFICATION="your-verification-token"

# ─── Optional: PageSpeed API (higher quota) ──────────────────────────────────
# PAGESPEED_API_KEY=""

# ─── Cloudflare R2 screenshot storage (REQUIRED for scanning in production) ──
# Without these, the service still boots but every scan fails at the screenshot
# step with a clear "scanner temporarily unavailable" message, and /api/health
# reports storageConfigured:false. Set all five to enable scanning.
# (Local dev falls back to .data/screenshots.)
# R2_BUCKET_NAME=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_URL=""

# ─── Email (Resend, required in production for nurture + expert review alerts) ─
# RESEND_API_KEY=""
# Use a from address on a domain verified in your Resend account (Dashboard → Domains).
# RESEND_FROM_EMAIL="FixFlags <hello@saadbenryane.com>"
# ADMIN_NOTIFICATION_EMAIL="you@example.com"  # Required in production (expert review + live chat alerts)

# ─── Live support ─────────────────────────────────────────────────────────────
# SUPPORT_TENANT_SLUG="fixflags"

# ─── Marketing sample (demo fixture) ───────────────────────────────────────────
SAMPLE_AUDIT_URL="https://fixflags.com/demo"
NEXT_PUBLIC_SAMPLE_AUDIT_URL="https://fixflags.com/demo"
# SAMPLE_CAPTURE_URL="http://localhost:3000/demo"  # Local screenshot capture target
# SAMPLE_INCLUDE_AI="false"  # Skip AI judge in refresh-marketing-sample.ts

# ─── Cron secret (optional) ──────────────────────────────────────────────────
# Recovery + nurture run automatically inside the worker. This secret only
# guards the manual trigger endpoints (/api/cron/*) if you ever call them.
# CRON_SECRET="generate-a-random-secret"

# ─── Optional: Admin access (comma-separated user IDs) ───────────────────────
# ADMIN_USER_IDS=""

# ─── Optional: LLM cost estimation (USD per million tokens) ──────────────────
# LLM_COST_INPUT_PER_MTOK="3"
# LLM_COST_OUTPUT_PER_MTOK="15"
