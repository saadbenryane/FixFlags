# --- Required ---

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qualityos"

# Redis (used by BullMQ for the audit job queue)
REDIS_URL="redis://localhost:6379"

# Anthropic API key for the AI judge (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# --- Stripe billing (required for paid plans; app works on free tier without it) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BUILDER_PRICE_ID=""
STRIPE_TEAM_PRICE_ID=""
STRIPE_STUDIO_PRICE_ID=""

# --- Optional: social login ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Optional: Cloudflare R2 for screenshot storage (screenshots skipped if unset) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Optional: Google PageSpeed API key (raises rate limits; works unauthenticated) ---
PAGESPEED_API_KEY=""

# --- Optional: comma-separated user IDs with access to /admin ---
ADMIN_USER_IDS=""
