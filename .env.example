# ─── Local verify prerequisites ─────────────────────────────────────────────
# cp .env.example .env.local
# BETTER_AUTH_SECRET=$(openssl rand -hex 32)  # required — placeholder fails auth validation
# docker compose up -d && npm run setup
# npm run verify  # stricter than CI (includes db:validate, db:check, db:drift)

# ─── Required for audits ───────────────────────────────────────────────────
DATABASE_URL="postgresql://fixflags:fixflags@localhost:5432/fixflags"
REDIS_URL="redis://localhost:6379"
# Runtime role is explicit. Web processes enqueue only; worker processes own
# Playwright, recovery, and audit execution.
# FIXFLAGS_PROCESS_ROLE="web"
# Parallel audit jobs per worker process (default 1 locally, 2 in production).
# AUDIT_WORKER_CONCURRENCY="2"
# Set at least one LLM provider for triage (phase 1, every scan) and prescription
# (phase 2, signed-in users with quota). Without keys, scans complete with
# deterministic checks only and /api/health reports aiConfigured:false.
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ─── Advanced: AI judge tuning (optional) ────────────────────────────────────
# JUDGE_PROVIDER_CHAIN="openai,anthropic"   # order to try providers
# TRIAGE_MODEL="gpt-4o-mini"                # cheaper model for anonymous triage pass
# TRIAGE_MAX_TOKENS="1500"                  # keeps triage output cheap
# OPENAI_JUDGE_MODEL="gpt-4o-mini"
# ANTHROPIC_JUDGE_MODEL="claude-sonnet-4-20250514"
# OPENAI_JUDGE_MAX_TOKENS="4096"
# OPENAI_JUDGE_IMAGE_DETAIL="low"           # low | high | auto
# JUDGE_TIMEOUT_MS="60000"                  # clamped to the audit's remaining budget
# CRITICAL_PATH_CONCURRENCY="3"             # parallel pages for critical-path audits

# ─── Required for auth ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET="generate-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Railway web service): set all three to https://fixflags.com
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL must match exactly.

# ─── OAuth SSO (Google / GitHub) — both ID + secret required per provider ───
# Provider availability is resolved at RUNTIME (GET /api/auth/providers), so
# setting these on the deployed service lights up the sign-in buttons with NO
# rebuild required. Callback URLs to register in each provider console:
#   Google: {BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub: {BETTER_AUTH_URL}/api/auth/callback/github
# Local: http://localhost:3000/api/auth/callback/google (and github)
# Prod:  https://fixflags.com/api/auth/callback/google (and github)
# Run: npm run auth:check
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# The same GitHub OAuth app also powers Agency-plan codebase scanning
# (lib/integrations/github.ts) with a separate `repo`-scope callback.
# Register this additional callback URL in the same GitHub OAuth app:
#   {BETTER_AUTH_URL}/api/integrations/github/callback

# ─── Required for codebase scanning (Agency plan) ───────────────────────────────
# Encrypts GitHub access tokens at rest (AES-256-GCM). Generate: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=""

# ─── Stripe billing (test vs live = key prefix only) ───────────────────────────
# Full set required when BILLING_REQUIRED=true (Railway production).
# Docs: docs/stripe-setup.md
# Local: npm run stripe:listen (optional; forwards webhooks to localhost)
# STRIPE_SECRET_KEY=""                         # sk_test_... or sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""         # pk_test_... or pk_live_... (hosted Checkout does not need client SDK)
# STRIPE_RESTRICTED_KEY=""                     # rk_... operator/MCP only; NOT used by the app
# STRIPE_WEBHOOK_SECRET=""                     # whsec_... Dashboard endpoint or stripe listen
# STRIPE_BUILDER_PRICE_ID=""                   # Pro $29/mo
# STRIPE_TEAM_PRICE_ID=""                      # Agency $99/mo
# STRIPE_CREDIT_PACK_10_ID=""
# STRIPE_CREDIT_PACK_25_ID=""
# STRIPE_CREDIT_PACK_50_ID=""
# STRIPE_API_VERSION="2025-02-24.acacia"
# BILLING_REQUIRED="false"                     # true on revenue deploys; fails boot if Stripe incomplete

# ─── Optional: Google Analytics 4 (frontend tracking) ───────────────────────
# GA4 Measurement ID. When set, gtag.js loads and tracks pageviews/events.
# Leave unset to disable analytics entirely (e.g. local dev).
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ─── Optional: Google Ads conversion tracking ───────────────────────────────
# NEXT_PUBLIC_GOOGLE_ADS_ID=""
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=""

# ─── Optional: Meta Pixel + Conversions API ─────────────────────────────────
# NEXT_PUBLIC_META_PIXEL_ID=""
# META_CAPI_TOKEN=""

# ─── Optional: Google Search Console ────────────────────────────────────────
# Service account key file path (for GSC/GA4 API access)
# GSC_SERVICE_ACCOUNT_KEY=""
# Domain verification meta tag content
# GOOGLE_SITE_VERIFICATION="your-verification-token"

# ─── Optional: Railway deployment webhook (post-deploy Launch Check) ─────────
# Railway → Project → Settings → Webhooks:
#   URL: https://fixflags.com/api/webhooks/railway?apiKey=ff_live_YOUR_KEY&url=https://YOUR-SERVICE.up.railway.app
# Optional shared secret (append &webhookSecret=... to the URL):
# RAILWAY_WEBHOOK_SECRET=""

# ─── PageSpeed API (recommended for production) ───────────────────────────────
# Without a key, PageSpeed calls use IP-based quota and often return 429.
# PAGESPEED_API_KEY=""

# ─── Cloudflare R2 screenshot storage (REQUIRED for scanning in production) ──
# Without these, the service still boots but every scan fails at the screenshot
# step with a clear "scanner temporarily unavailable" message, and /api/health
# reports storageConfigured:false. Set all five to enable scanning.
# (Local dev falls back to .data/screenshots.)
# R2_BUCKET_NAME=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_URL=""

# ─── Email (Resend, required in production for nurture alerts) ────────────────
# RESEND_API_KEY=""
# Use a from address on a domain verified in your Resend account (Dashboard → Domains).
# RESEND_FROM_EMAIL="FixFlags <hello@saadbenryane.com>"
# ADMIN_NOTIFICATION_EMAIL="you@example.com"  # Required in production (live chat alerts)

# ─── Stripe private beta gate ─────────────────────────────────────────────────
# When true, paid checkout is replaced with an email-capture interest form.
# Remove this once Stripe is out of test mode.
# NEXT_PUBLIC_STRIPE_BETA_GATING="true"
# STRIPE_BETA_GATING="true"

# ─── Live support ─────────────────────────────────────────────────────────────
# SUPPORT_TENANT_SLUG="fixflags"

# ─── Marketing sample (demo fixture) ───────────────────────────────────────────
SAMPLE_AUDIT_URL="https://fixflags.com/demo"
NEXT_PUBLIC_SAMPLE_AUDIT_URL="https://fixflags.com/demo"
# SAMPLE_CAPTURE_URL="http://localhost:3000/demo"  # Local screenshot capture target
# SAMPLE_INCLUDE_AI="false"  # Skip AI judge in refresh-marketing-sample.ts

# ─── Cron secret (optional) ──────────────────────────────────────────────────
# Recovery + nurture run automatically inside the worker. This secret only
# guards the manual trigger endpoints (/api/cron/*) if you ever call them.
# CRON_SECRET="generate-a-random-secret"

# ─── Optional: Local billing gate testing ────────────────────────────────────
# DEV_SIMULATE_BILLING="true"  # Enforce plan gates locally (share, compare, API keys)

# ─── Optional: Admin access (comma-separated user IDs) ───────────────────────
# ADMIN_USER_IDS=""
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-local-password"

# ─── Optional: LLM cost estimation (USD per million tokens) ──────────────────
# LLM_COST_INPUT_PER_MTOK="3"
# LLM_COST_OUTPUT_PER_MTOK="15"
