# ─── Required for audits ───────────────────────────────────────────────────
DATABASE_URL="postgresql://qualityos:qualityos@localhost:5432/qualityos"
REDIS_URL="redis://localhost:6379"
# Set one LLM provider (OpenAI is preferred when both are set):
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ─── Required for auth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scan/token limits are automatically disabled when NODE_ENV=development (npm run dev).

# ─── Optional: OAuth ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ─── Optional: Stripe billing ────────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_BUILDER_PRICE_ID=""
# STRIPE_TEAM_PRICE_ID=""
# STRIPE_STUDIO_PRICE_ID=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Optional: PageSpeed API (higher quota) ──────────────────────────────────
# PAGESPEED_API_KEY=""

# ─── Optional: Cloudflare R2 screenshot storage ──────────────────────────────
# R2_BUCKET_NAME=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_URL=""

# ─── Optional: Email (Resend) ────────────────────────────────────────────────
# RESEND_API_KEY=""

# ─── Optional: Admin access (comma-separated user IDs) ───────────────────────
# ADMIN_USER_IDS=""

# ─── Optional: LLM cost estimation (USD per million tokens) ──────────────────
# LLM_COST_INPUT_PER_MTOK="3"
# LLM_COST_OUTPUT_PER_MTOK="15"
