# ─── Required for audits ───────────────────────────────────────────────────
DATABASE_URL="postgresql://fixflags:fixflags@localhost:5432/fixflags"
REDIS_URL="redis://localhost:6379"
# Set one LLM provider (OpenAI is preferred when both are set):
OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ─── Required for auth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://fixflags.com
# Required in dev for local screenshot URLs (/api/screenshots/…). Production uses R2.

# Scan/token limits are automatically disabled when NODE_ENV=development (npm run dev).
# Set DEV_SIMULATE_BILLING=true to test real plan gates (recheck trial, share links) locally.
# DEV_SIMULATE_BILLING="true"

# ─── Optional: OAuth (Google / GitHub sign-in buttons appear when both ID + secret are set) ─
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ─── Stripe billing (required in production) ─────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_BUILDER_PRICE_ID=""
# STRIPE_BUILDER_FOUNDING_PRICE_ID=""
# STRIPE_TEAM_PRICE_ID=""
# STRIPE_STUDIO_PRICE_ID=""
# STRIPE_STUDIO_FOUNDING_PRICE_ID=""
# STRIPE_EXPERT_REVIEW_PRICE_ID=""

# ─── Optional: Google Analytics 4 (frontend tracking) ───────────────────────
# GA4 Measurement ID. When set, gtag.js loads and tracks pageviews/events.
# Leave unset to disable analytics entirely (e.g. local dev).
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ─── Optional: Google Search Console domain verification ─────────────────────
# Meta tag content value from Search Console → Settings → Ownership verification
# GOOGLE_SITE_VERIFICATION="your-verification-token"

# ─── Optional: PageSpeed API (higher quota) ──────────────────────────────────
# PAGESPEED_API_KEY=""

# ─── Cloudflare R2 screenshot storage (required in production) ─────────────
# R2_BUCKET_NAME=""
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PUBLIC_URL=""

# ─── Email (Resend, required in production for nurture + expert review alerts) ─
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="FixFlags <hello@fixflags.com>"
# ADMIN_NOTIFICATION_EMAIL="you@example.com"

# SAMPLE_AUDIT_URL=""  # URL used for sample audit on the samples page

# ─── Cron (required in production) ───────────────────────────────────────────
# CRON_SECRET="generate-a-random-secret"

# ─── Optional: Admin access (comma-separated user IDs) ───────────────────────
# ADMIN_USER_IDS=""

# ─── Optional: LLM cost estimation (USD per million tokens) ──────────────────
# LLM_COST_INPUT_PER_MTOK="3"
# LLM_COST_OUTPUT_PER_MTOK="15"
