# ─── Required ──────────────────────────────────────────────────────────────

# Postgres connection string (web app + worker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qewos

# Redis connection string (BullMQ audit queue, web app + worker)
REDIS_URL=redis://localhost:6379

# Public base URL of the app, used for auth callbacks and links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign auth sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Anthropic API key — the worker refuses to start without it (lib/audit/judge.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe secret key — the Stripe client is created at import time and the
# dashboard imports from lib/stripe.ts, so SOME value is required even if you
# never touch billing. A dummy sk_test_ string is fine for local browsing.
STRIPE_SECRET_KEY=sk_test_dummy

# ─── Screenshots (Cloudflare R2) ───────────────────────────────────────────
# Required for the screenshot-upload step of an audit to succeed.
# Everything else works without these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Optional ──────────────────────────────────────────────────────────────

# Override the auth base URL (defaults to NEXT_PUBLIC_APP_URL)
# BETTER_AUTH_URL=http://localhost:3000

# PageSpeed Insights — works without a key at a lower quota
# PAGESPEED_API_KEY=

# Social login (email + password is enabled by default)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Stripe billing — only needed for real checkout / webhooks
# STRIPE_WEBHOOK_SECRET=
# STRIPE_BUILDER_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=
# STRIPE_STUDIO_PRICE_ID=

# Comma-separated user IDs granted access to /admin
# ADMIN_USER_IDS=
