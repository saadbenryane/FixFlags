{
  "name": "fixflags",
  "version": "1.0.2",
  "description": "Agent-native FixFlags CLI. Check, finish, and verify AI-built products.",
  "type": "module",
  "bin": {
    "fixflags": "./bin/fixflags.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "package:check": "npm run build && node test/package-contents.mjs"
  },
  "keywords": [
    "qa",
    "testing",
    "ai",
    "lighthouse",
    "performance",
    "accessibility",
    "seo",
    "fixflags",
    "cursor",
    "lovable",
    "bolt",
    "vibe-coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadbenryane/QewOS.git",
    "directory": "fixflags-cli"
  },
  "homepage": "https://fixflags.com",
  "bugs": {
    "url": "https://github.com/saadbenryane/QewOS/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "open": "^11.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
