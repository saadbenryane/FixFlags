    "directory": "fixflags-cli"
  },
  "homepage": "https://fixflags.com",
  "bugs": {
    "url": "https://github.com/fixflags/fixflags/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0"
