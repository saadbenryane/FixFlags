{
  "name": "qualityos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c blue,green \"npm run dev\" \"npm run worker\"",
    "build": "next build",
    "prestart": "npm run db:deploy && npm run db:check",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "tsx --test lib/__tests__/hardening.test.ts lib/audit/__tests__/viewports.test.ts lib/audit/__tests__/screenshot-types.test.ts lib/storage/__tests__/screenshots.test.ts",
    "worker": "tsx watch worker/index.ts",
    "worker:build": "tsc --project tsconfig.worker.json",
    "preworker:start": "npm run db:deploy && npm run db:check",
    "worker:start": "node dist/worker/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma migrate dev",
    "db:deploy": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma migrate deploy",
    "db:check": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma migrate status",
    "db:drift": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma migrate diff --from-config-datasource --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:validate": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma validate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run db:validate && npm run db:check && npm run db:drift && npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run worker:build",
    "setup": "docker compose up -d && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-accordion": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-progress": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@stripe/stripe-js": "^4.0.0",
    "better-auth": "^1.6.15",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.0.0",
    "lucide-react": "^0.454.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "node-html-parser": "^6.0.0",
    "openai": "^6.42.0",
    "prisma": "^6.0.0",
    "puppeteer": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "sonner": "^1.0.0",
    "stripe": "^17.0.0",
    "swr": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
