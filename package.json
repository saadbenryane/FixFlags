{
  "name": "fixflags",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/kill-port.mjs && npm run doctor",
    "dev": "concurrently -k -n web,worker -c blue,green \"npm run dev:web\" \"npm run worker\"",
    "dev:web": "FIXFLAGS_PROCESS_ROLE=web NODE_ENV=development next dev",
    "dev:all": "npm run dev",
    "dev:full": "npm run dev",
    "doctor": "DOTENV_CONFIG_PATH=.env.local node scripts/doctor.mjs",
    "build": "NODE_ENV=production next build",
    "start": "node scripts/runtime-start.mjs web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "brand:hex-guard": "node scripts/brand-hex-guard.mjs",
    "ui:drift-guard": "node scripts/ui-drift-guard.mjs",
    "image:local-patterns-guard": "node scripts/image-local-patterns-guard.mjs",
    "product:contract-guard": "node scripts/product-contract-guard.mjs",
    "routes:contract-guard": "node scripts/route-contract-registry.mjs",
    "skills:validate": "node scripts/skill-validator.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "seo:guard": "node scripts/seo-guard.mjs",
    "knowledge:duplication-guard": "node scripts/knowledge-duplication-guard.mjs",
    "completeness:audit": "node scripts/completeness-audit.mjs",
    "mcp:quality-gate": "node scripts/mcp-quality-gate.mjs",
    "auth:check": "tsx scripts/check-auth-env.ts",
    "test:unit": "vitest run",
    "test:cli": "npm --prefix fixflags-cli test && npm --prefix fixflags-cli run package:check",
    "test:e2e": "playwright test",
    "test:e2e:release": "E2E_FULL=true E2E_CREDENTIALED=true playwright test",
    "test:watch": "vitest",
    "demo:audit": "tsx scripts/demo-fixture-audit.ts",
    "demo:audit:offline": "tsx scripts/demo-fixture-audit.ts --offline",
    "accuracy:eval": "tsx scripts/accuracy-eval.ts",
    "accuracy:probe": "npm run accuracy:browser --",
    "accuracy:browser": "tsx scripts/accuracy-browser-probe.ts",
    "accuracy:capture-fixtures": "tsx scripts/capture-accuracy-fixtures.ts",
    "accuracy:generate-rubrics-tiles": "node scripts/generate-rubrics-tiles.mjs",
    "demo:audit:flow": "tsx scripts/demo-fixture-flow-audit.ts",
    "demo:audit:production": "tsx scripts/demo-fixture-audit.ts https://fixflags.com --production",
    "smoke:triage:prod": "tsx scripts/smoke-triage-prod.ts",
    "audit:capabilities": "tsx scripts/audit-capability-report.ts",
    "signups": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/signup-count.ts",
    "worker": "FIXFLAGS_PROCESS_ROLE=worker AUDIT_WORKER_CONCURRENCY=${AUDIT_WORKER_CONCURRENCY:-1} tsx worker/index.ts",
    "worker:watch": "FIXFLAGS_PROCESS_ROLE=worker AUDIT_WORKER_CONCURRENCY=${AUDIT_WORKER_CONCURRENCY:-1} tsx watch worker/index.ts",
    "worker:build": "tsc --project tsconfig.worker.json && tsc-alias --project tsconfig.worker.json",
    "worker:test": "vitest run --project server worker/",
    "worker:start": "node scripts/runtime-start.mjs worker",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-run.mjs prisma migrate dev",
    "db:deploy": "node scripts/db-run.mjs prisma migrate deploy",
    "db:check": "node scripts/db-run.mjs prisma migrate status",
    "db:drift": "node scripts/db-run.mjs prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:validate": "node scripts/db-run.mjs prisma validate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config prisma/seed.ts",
    "stripe:listen": "stripe listen --forward-to http://localhost:3000/api/webhooks/stripe --api-version 2025-02-24.acacia",
    "backfill:leads": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/backfill-leads.ts",
    "graph:backfill": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/graph/backfill-historical.ts",
    "growth:rollup-issues": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/growth/issue-frequencies.ts",
    "growth:pull-gsc": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/growth/pull-gsc.ts",
    "growth:self-seed": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/growth/self-seed.ts",
    "growth:pull-ga": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/growth/pull-ga.ts",
    "growth:backfill-tech": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/graph/backfill-tech-detect.ts",
    "verify": "node scripts/validate.mjs full",
    "verify:release": "node scripts/validate.mjs release",
    "smoke:release": "node scripts/release-smoke.mjs",
    "validate:quick": "node scripts/validate.mjs quick",
    "validate:affected": "node scripts/validate.mjs affected",
    "validate:full": "node scripts/validate.mjs full",
    "validate:release": "node scripts/validate.mjs release",
    "lint:changed": "node scripts/validate.mjs lint-changed",
    "test:scripts": "node --test scripts/validate.test.mjs scripts/completeness-audit.test.mjs scripts/project-agent.test.mjs scripts/route-contract-registry.test.mjs scripts/route-boundary-smoke.test.mjs scripts/skill-validator.test.mjs",
    "agent": "node scripts/project-agent.mjs",
    "cli:registry-guard": "node scripts/verify-cli-registry.mjs",
    "test:agent": "node --test scripts/project-agent.test.mjs scripts/validate.test.mjs",
    "agent:benchmark": "node scripts/harness-benchmark.mjs",
    "test:agent-benchmark": "node --test scripts/harness-benchmark.test.mjs",
    "agent:eval": "node scripts/agent-evals/main.mjs",
    "setup": "docker compose up -d && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@better-auth/core": "1.6.24",
    "@better-auth/passkey": "1.6.24",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@next/third-parties": "^15.5.21",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-accordion": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-progress": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "better-auth": "1.6.24",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dotenv": "^16.4.7",
    "googleapis": "^173.0.0",
    "ioredis": "^5.0.0",
    "lucide-react": "^0.454.0",
    "next": "^15.5.21",
    "next-themes": "^0.4.6",
    "omggif": "^1.0.10",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "resend": "^4.0.0",
    "sharp": "0.35.0",
    "sonner": "^1.0.0",
    "stripe": "^17.0.0",
    "swr": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "better-auth": "1.6.24",
    "@better-auth/passkey": "1.6.24",
    "@better-auth/core": "1.6.24",
    "better-call": "1.3.7",
    "sharp": "0.35.0",
    "@hono/node-server": "2.0.11",
    "postcss": "$postcss",
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "png-to-ico": "^3.0.1",
    "postcss": "8.5.22",
    "tailwindcss": "^3.4.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
