{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fixflags": {
      "type": "streamable-http",
      "url": "https://fixflags.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["sites:read", "runs:read", "runs:write", "flags:read", "flags:write"]
          }
        }
      }
    }
  }
}
